# ============================================================
# MyCRM LeadGenPlus — variables d'environnement (EXEMPLE)
# Copier ce fichier en ".env.local" (app Next.js) et/ou ".env" (outils Python)
# et remplir avec les vraies valeurs. NE JAMAIS committer les vrais secrets.
# ============================================================

# --- Supabase (côté client — exposé au navigateur, donc clé "anon" uniquement) ---
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre_cle_anon_publique

# --- Supabase (côté serveur UNIQUEMENT — ne jamais exposer au client) ---
# Utilisée par les routes API Next.js et les outils Python d'import.
SUPABASE_SERVICE_ROLE_KEY=votre_cle_service_role_secrete

# --- Rate limiting de l'API d'import (checklist secure.md) ---
# Nombre max de requêtes d'import par fenêtre, et durée de la fenêtre en secondes.
IMPORT_RATE_LIMIT_MAX=20
IMPORT_RATE_LIMIT_WINDOW_SECONDS=600

# --- Ingestion LeadGenEngine (POST /api/leads/import) ---
# Clé partagée avec le moteur externe LeadGenEngine, envoyée dans le header
# "x-api-key". Générer une valeur longue et aléatoire, par exemple avec :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Si cette variable est absente, la route refuse tout appel (503).
LEADGEN_API_KEY=remplacer_par_une_cle_aleatoire_de_64_caracteres

# Rate limiting de cette route (max 500 leads par requête).
LEADGEN_RATE_LIMIT_MAX=60
LEADGEN_RATE_LIMIT_WINDOW_SECONDS=600

# --- Outils Python (tools/) — réutilisent les mêmes valeurs Supabase ---
# SUPABASE_URL peut reprendre NEXT_PUBLIC_SUPABASE_URL ci-dessus.
SUPABASE_URL=https://votre-projet.supabase.co
